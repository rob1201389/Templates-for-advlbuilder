# RSMotoCons Platform — environment template.
# Copy to .env and fill in. NEVER commit real values.

# PostgreSQL (e.g. Neon, Supabase, RDS)
DATABASE_URL="postgresql://user:password@host:5432/rsmotocons?sslmode=require"

# Session signing — at least 32 random characters
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# APP 11 field encryption — exactly 32 bytes, base64
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe (Connect platform account)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# S3 bucket for generated tax invoices (private; SSE enabled)
INVOICE_BUCKET=""
AWS_REGION="ap-southeast-2"

# Public base URL of the app (checkout redirects)
APP_BASE_URL="https://app.rsmotocons.com"
